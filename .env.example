# Copy to .env and fill in. Every variable the code reads is listed; the value shown is the
# code's default (empty = unset). Descriptions: README.md, "Environment Variables".

PORT=8000
GUNICORN_WORKERS=1
BACKEND_URL=http://localhost:8000
ENABLE_SIP_LISTENER=true
ENABLE_DISPATCHER=true
MONGODB_URL=mongodb://<user>:<password>@localhost:27017
DATABASE_NAME=livekit_db
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=<livekit-api-key>
LIVEKIT_API_SECRET=<livekit-api-secret>
OPENAI_API_KEY=
GOOGLE_API_KEY=
CARTESIA_API_KEY=
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
MISTRAL_API_KEY=
HEALTH_PROBE_TIMEOUT_S=3
OPENAI_MODEL_CACHE_TTL=3600
MAX_CONCURRENT_JOBS=12
MAX_CONCURRENT_WEB_CALLS=40
MAX_CONCURRENT_MEETING_CALLS=4
MAX_CONCURRENT_SESSIONS=48
MAX_CONCURRENT_INVITE_SETUPS=24
MEETING_CONNECTOR_AGENT_NAME=meet-connector
MEETING_CONNECTOR_JOIN_TIMEOUT_SECONDS=120
MEETING_CONNECTOR_READY_TIMEOUT_SECONDS=360
END_CALL_WEBHOOK_TIMEOUT=30
END_CALL_WEBHOOK_ATTEMPTS=3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_RECORDINGS_PREFIX=recordings/
S3_GREETING_PREFIX=greeting_audio/
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Your App Name
LOG_LEVEL=INFO
LOG_JSON_FORMAT=False
LOG_FILE=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
EXOTEL_SIP_HOST=pstn.in1.exotel.com
EXOTEL_SIP_PORT=5070
EXOTEL_CUSTOMER_IP=
EXOTEL_CUSTOMER_SIP_PORT=5061
EXOTEL_MEDIA_IP=
EXOTEL_CALLER_ID=08044319240
EXOTEL_FROM_DOMAIN=lokaviveka1m.pstn.exotel.com
EXOTEL_AUTH_USERNAME=
EXOTEL_AUTH_PASSWORD=
EXOTEL_SIP_ALLOWED_IPS=
INBOUND_SIP_LISTEN=true
INBOUND_RING_UNTIL_AGENT_READY=true
INBOUND_MAX_RING_SECONDS=15
INBOUND_MEDIA_READY_TIMEOUT=20
SIP_BRIDGE_PORT_RANGE_START=41000
SIP_BRIDGE_PORT_RANGE_END=42000
NO_RTP_AFTER_ANSWER_SECONDS=60
RTP_SILENCE_TIMEOUT_SECONDS=30
